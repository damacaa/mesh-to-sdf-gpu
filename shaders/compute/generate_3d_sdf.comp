#version 460 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(r32f, binding = 0) uniform writeonly image3D u_sdfTexture;

uniform ivec3 u_resolution;
uniform float u_worldSize;
uniform vec3 u_worldOffset;
uniform int u_bakeMode; // 0 = Sphere, 1 = Scene 2 Primitives, 2 = Room with Window

#include "hg_sdf.glsl"

float roomWithWindowSDF(vec3 p)
{
	// Outer room box: width 4.8m (X: +/-2.4), height 3.6m (Y: +/-1.8), depth 4.8m (Z: +/-2.4)
	vec3 roomOuter = vec3(2.4, 1.8, 2.4);
	float dOuter = fBox(p, roomOuter);

	// Inner room box: wall thickness 0.25m -> hollow interior
	vec3 roomInner = vec3(2.15, 1.55, 2.15);
	float dInner = fBox(p, roomInner);

	// Hollow closed room (max with inverted inner box)
	float dRoom = max(dOuter, -dInner);

	// Subtract cube for window opening on the back wall (-Z)
	vec3 windowCenter = vec3(0.0, 0.0, -2.3);
	vec3 windowHalfSize = vec3(0.8, 0.6, 0.35);
	float dWindow = fBox(p - windowCenter, windowHalfSize);

	// Window made with a subtract cube
	return max(dRoom, -dWindow);
}

float scene2SDF(vec3 p)
{
	float minDist = 1e5;

	// Ground plane
	{
		float d = fPlane(p, vec3(0.0, 1.0, 0.0), 0.0);
		minDist = min(minDist, d);
	}
	// Center torus
	{
		vec3 pt = p - vec3(0.0, 1.5, 0.0);
		pR(pt.xy, 0.4);
		float d = fTorus(pt, 0.35, 1.1);
		minDist = min(minDist, d);
	}
	// Left sphere
	{
		float d = fSphere(p - vec3(-2.2, 1.0, -0.5), 1.0);
		minDist = min(minDist, d);
	}
	// Right smooth union of box and sphere
	{
		vec3 pb = p - vec3(2.2, 1.0, -0.5);
		float dBox = fBox(pb, vec3(0.7, 0.7, 0.7));
		float dSph = fSphere(pb, 0.9);
		float d = fOpUnionSoft(dBox, dSph, 0.3);
		minDist = min(minDist, d);
	}
	// Floating center sphere
	{
		float d = fSphere(p - vec3(0.0, 1.5, 0.0), 0.45);
		minDist = min(minDist, d);
	}
	// Background columns
	{
		vec3 pc1 = p - vec3(-3.5, 2.5, -3.5);
		float d1 = fCylinder(pc1, 0.4, 2.5);
		vec3 pc2 = p - vec3(3.5, 2.5, -3.5);
		float d2 = fCylinder(pc2, 0.4, 2.5);
		float d = min(d1, d2);
		minDist = min(minDist, d);
	}

	return minDist;
}

void main()
{
	ivec3 voxelCoord = ivec3(gl_GlobalInvocationID.xyz);
	if (voxelCoord.x >= u_resolution.x || voxelCoord.y >= u_resolution.y || voxelCoord.z >= u_resolution.z)
	{
		return;
	}

	// Calculate normalized texture coordinate at voxel center [0.0, 1.0]
	vec3 uvw = (vec3(voxelCoord) + 0.5) / vec3(u_resolution);

	// Map [0.0, 1.0] to world-space position using worldSize and worldOffset
	vec3 worldPos = (uvw - 0.5) * u_worldSize + u_worldOffset;

	float dist = 0.0;
	if (u_bakeMode == 0)
	{
		// 1.0m diameter sphere centered at u_worldOffset
		dist = length(worldPos - u_worldOffset) - 0.5;
	}
	else if (u_bakeMode == 1)
	{
		// Scene 2 geometric primitives
		dist = scene2SDF(worldPos);
	}
	else if (u_bakeMode == 2)
	{
		// Closed room with subtract cube window
		dist = roomWithWindowSDF(worldPos - u_worldOffset);
	}

	imageStore(u_sdfTexture, voxelCoord, vec4(dist, 0.0, 0.0, 0.0));
}
