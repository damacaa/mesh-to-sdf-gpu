#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(r32i, binding = 0) uniform iimage3D u_windingDelta;

#include "sdf_common.glsl"

layout(std430, binding = 0) readonly buffer TriangleBuffer
{
	GpuTriangle triangles[];
};

uniform ivec3 u_resolution;
uniform float u_worldSize;
uniform vec3 u_worldOffset;
uniform uint u_triangleCount;
uniform int u_axis; // 0 = +X, 1 = +Y, 2 = +Z

void main()
{
	uint triIdx = gl_GlobalInvocationID.x;
	if (triIdx >= u_triangleCount)
	{
		return;
	}

	GpuTriangle tri = triangles[triIdx];
	// Ignore open single-sided sheets so they do not corrupt closed-volume winding.
	if (tri.n0.w >= 0.5)
	{
		return;
	}

	int wAxis = u_axis;
	int uAxis = (u_axis + 1) % 3;
	int vAxis = (u_axis + 2) % 3;

	float voxelSize = u_worldSize / float(u_resolution.x);
	vec3 gridOrigin = u_worldOffset - vec3(u_worldSize * 0.5);

	// Express vertices in voxel-center coordinates so voxel center k is at integer k.
	vec3 va = (tri.v0.xyz - gridOrigin) / voxelSize - 0.5;
	vec3 vb = (tri.v1.xyz - gridOrigin) / voxelSize - 0.5;
	vec3 vc = (tri.v2.xyz - gridOrigin) / voxelSize - 0.5;

	vec2 p0 = vec2(va[uAxis], va[vAxis]);
	vec2 p1 = vec2(vb[uAxis], vb[vAxis]);
	vec2 p2 = vec2(vc[uAxis], vc[vAxis]);

	float area = (p1.x - p0.x) * (p2.y - p0.y) - (p1.y - p0.y) * (p2.x - p0.x);
	if (abs(area) < 1e-10)
	{
		return;
	}

	// Right-handed (u, v, w): area < 0 means normal[w] < 0, so a +w ray enters (+1).
	int delta = (area < 0.0) ? 1 : -1;
	float invArea = 1.0 / area;

	// Use a small sub-voxel offset so grid rays avoid shared edges and vertices.
	const vec2 rayBias = vec2(1.13e-4, 2.71e-4);

	vec2 uvMin = min(p0, min(p1, p2)) - rayBias;
	vec2 uvMax = max(p0, max(p1, p2)) - rayBias;
	int uMin = max(int(ceil(uvMin.x)), 0);
	int uMax = min(int(floor(uvMax.x)), u_resolution[uAxis] - 1);
	int vMin = max(int(ceil(uvMin.y)), 0);
	int vMax = min(int(floor(uvMax.y)), u_resolution[vAxis] - 1);
	if (uMin > uMax || vMin > vMax)
	{
		return;
	}

	int wRes = u_resolution[wAxis];
	for (int iv = vMin; iv <= vMax; ++iv)
	{
		for (int iu = uMin; iu <= uMax; ++iu)
		{
			vec2 p = vec2(float(iu), float(iv)) + rayBias;
			float e0 = (p1.x - p0.x) * (p.y - p0.y) - (p1.y - p0.y) * (p.x - p0.x);
			float e1 = (p2.x - p1.x) * (p.y - p1.y) - (p2.y - p1.y) * (p.x - p1.x);
			float e2 = (p0.x - p2.x) * (p.y - p2.y) - (p0.y - p2.y) * (p.x - p2.x);

			float w2 = e0 * invArea;
			float w0 = e1 * invArea;
			float w1 = e2 * invArea;
			if (w0 < 0.0 || w1 < 0.0 || w2 < 0.0)
			{
				continue;
			}

			float wHit = w0 * va[wAxis] + w1 * vb[wAxis] + w2 * vc[wAxis];
			int iw = max(int(ceil(wHit)), 0);
			if (iw < wRes)
			{
				ivec3 cell;
				cell[uAxis] = iu;
				cell[vAxis] = iv;
				cell[wAxis] = iw;
				imageAtomicAdd(u_windingDelta, cell, delta);
			}
		}
	}
}
