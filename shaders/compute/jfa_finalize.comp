#version 460 core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#ifndef SDF_IMAGE_FORMAT
#define SDF_IMAGE_FORMAT r32f
#endif

layout(SDF_IMAGE_FORMAT, binding = 0) uniform writeonly image3D u_sdfTexture;
layout(rgba32f, binding = 1) uniform readonly image3D u_seedPosTex;
layout(rgba32f, binding = 2) uniform readonly image3D u_seedNormTex;
layout(r32ui, binding = 3) uniform readonly uimage3D u_windingVotes;

#include "sdf_common.glsl"

uniform ivec3 u_resolution;
uniform float u_worldSize;
uniform vec3 u_worldOffset;
uniform int u_unsignedDistance;
uniform float u_shellHalfThickness;
uniform int u_useWindingVotes;

void main()
{
	ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
	if (any(greaterThanEqual(coord, u_resolution)))
	{
		return;
	}

	vec4 seedPos = imageLoad(u_seedPosTex, coord);
	if (seedPos.w < 0.5)
	{
		imageStore(u_sdfTexture, coord, vec4(u_worldSize, 0.0, 0.0, 0.0));
		return;
	}

	vec3 worldPos = voxelToWorld(coord, u_resolution, u_worldSize, u_worldOffset);
	vec4 seedNormSample = imageLoad(u_seedNormTex, coord);
	vec3 seedNorm = seedNormSample.xyz;
	vec3 diff = worldPos - seedPos.xyz;
	float outDist;
	if (u_unsignedDistance != 0)
	{
		outDist = length(diff);
	}
	else if (u_shellHalfThickness > 0.0)
	{
		// Build a thin signed slab behind each captured surface sample so the front face stays at zero.
		float s = dot(diff, seedNorm);
		float tPerp = length(diff - s * seedNorm);
		float voxel = u_worldSize / float(u_resolution.x);
		float patchRadius = 1.2 * voxel;
		vec2 q2 = vec2(tPerp - patchRadius, abs(s + u_shellHalfThickness) - u_shellHalfThickness);
		outDist = length(max(q2, vec2(0.0))) + min(max(q2.x, q2.y), 0.0);
	}
	else if (u_useWindingVotes != 0)
	{
		float dist = length(diff);
		float voxel = u_worldSize / float(u_resolution.x);
		if (seedNormSample.w >= 0.5)
		{
			// Give explicit double-sided sheets a minimal shell so they remain visible in signed volumes.
			outDist = dist - 0.55 * voxel;
		}
		else
		{
			// Six-direction winding quadrature; guard ambiguous far-field votes against inverted open trim.
			uint votes = imageLoad(u_windingVotes, coord).r;
			bool inside = (votes >= 5u)
				|| (votes >= 3u && (dot(diff, seedNorm) < 0.0 || dist < 0.75 * voxel));
			outDist = (inside ? -1.0 : 1.0) * dist;
		}
	}
	else
	{
		float sgn = (seedNormSample.w < 0.5 && dot(diff, seedNorm) < 0.0) ? -1.0 : 1.0;
		outDist = sgn * length(diff);
	}

	imageStore(u_sdfTexture, coord, vec4(outDist, 0.0, 0.0, 0.0));
}
