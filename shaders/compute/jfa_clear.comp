#version 460 core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(rgba32f, binding = 0) uniform writeonly image3D u_seedPosTex;
layout(rgba32f, binding = 1) uniform writeonly image3D u_seedNormTex;
layout(r32ui, binding = 2) uniform writeonly uimage3D u_seedAtomics;
layout(rgba32f, binding = 3) uniform writeonly image3D u_persistentSeedPosTex;
layout(rgba32f, binding = 4) uniform writeonly image3D u_persistentSeedNormTex;

uniform ivec3 u_resolution;
uniform int u_clearPersistent;

void main()
{
	ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
	if (any(greaterThanEqual(coord, u_resolution)))
	{
		return;
	}

	imageStore(u_seedPosTex, coord, vec4(0.0));
	imageStore(u_seedNormTex, coord, vec4(0.0));
	imageStore(u_seedAtomics, coord, uvec4(0xFFFFFFFFu, 0u, 0u, 0u));
	if (u_clearPersistent == 1)
	{
		imageStore(u_persistentSeedPosTex, coord, vec4(0.0));
		imageStore(u_persistentSeedNormTex, coord, vec4(0.0));
	}
}
